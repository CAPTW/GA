{
  "study_name": "onemax_adaptive_mutation_study",
  "description": "Compare fixed, decay, and stagnation-boost mutation schedules on small onemax under the same evaluation budget.",
  "problem": "onemax",
  "base_preset": "onemax_small",
  "shared_overrides": {
    "algorithm_options": {
      "adaptive_mutation_min_rate": 0.005,
      "adaptive_mutation_max_rate": 0.08,
      "stagnation_window": 5,
      "stagnation_boost_factor": 3.0
    }
  },
  "sweep": {
    "algorithm_options.adaptive_policy": ["none", "decay_mutation", "stagnation_boost"]
  },
  "seeds": [7, 8, 9],
  "budget_ceiling": 2080,
  "primary_metric": "evaluations_to_target",
  "plotting": {
    "history_metric": "best_fitness"
  },
  "runtime_budget_note": "Small adaptive onemax study, usually under a minute on a laptop."
}
