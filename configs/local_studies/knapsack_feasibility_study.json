  },
  "seeds": [11, 12, 13],
  "budget_ceiling": 4920,
  "primary_metric": "best_feasible_fitness",
  "plotting": {
    "history_metric": "best_fitness"
  },
  "runtime_budget_note": "Small feasibility-focused knapsack study, usually under two minutes on a laptop."
}
