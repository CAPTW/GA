{
  "study_name": "zdt1_qf_tolerance_study",
  "description": "ZDT1 Q/F tolerance coarse pass. Measure how much hypervolume, pareto ratio, and spread the budget-first fast profile gives up against the canonical diversity-injection default.",
  "problem": "zdt1",
  "base_config": "configs/local_profiles/zdt1_diversity_injection.json",
  "shared_overrides": {
    "log_every": 1
  },
  "variant_overrides": {
    "quality_first": {
      "population_size": 60,
      "generations": 80,
      "algorithm_options": {
        "adaptive_policy": "low_diversity_injection",
        "diversity_threshold": 0.55,
        "refresh_fraction": 0.1,
        "adaptation_cooldown": 4
      }
    },
    "budget_first": {
      "population_size": 45,
      "generations": 80,
      "algorithm_options": {
        "adaptive_policy": "low_diversity_injection",
        "diversity_threshold": 0.55,
        "refresh_fraction": 0.1,
        "adaptation_cooldown": 4
      }
    }
  },
  "analysis": {
    "qf_tolerance": {
      "quality_variant": "quality_first",
      "fast_variant": "budget_first",
      "tolerance_bins_pct": [0.1, 0.25, 0.5, 1.0],
      "pareto_ratio_drop_threshold": 0.01,
      "spread_degradation_threshold": 0.05
    }
  },
  "sweep": {
    "study_variant": ["quality_first", "budget_first"]
  },
  "seeds": [8201, 8202, 8203, 8204, 8205],
  "budget_ceiling": 14520,
  "primary_metric": "hypervolume",
  "plotting": {
    "history_metric": "hypervolume"
  },
  "runtime_budget_note": "Q/F tolerance coarse pass only. Keep the adaptive rule fixed and measure the fast-profile HV loss envelope before writing any quality-tolerance note."
}
