# Host-local ops environment using the logged-in Codex CLI session.
# Copy to `.env.ops-cli` and adjust only when needed.

GA_LAB_CODEX_BACKEND=cli
GA_LAB_CODEX_MODEL=gpt-5.4
GA_LAB_CODEX_CLI_COMMAND=codex

GA_LAB_OPS_DB_PATH=var/ops/ga_ops_cli.db
GA_LAB_LOGS_ROOT=var/ops/logs
GA_LAB_REPORTS_ROOT=outputs/reports
GA_LAB_DASHBOARD_RESULTS_DIR=outputs
GA_LAB_SCHEDULER_JOBS_PATH=configs/schedules/default_jobs.json
GA_LAB_SCHEDULER_TIMEZONE=Asia/Seoul

# Set this before exposing the API beyond your local machine.
GA_LAB_OPS_ADMIN_TOKEN=local-dev-admin
